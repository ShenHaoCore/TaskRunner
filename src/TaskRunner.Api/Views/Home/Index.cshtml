@model TaskRunner.Api.Controllers.HomeController.HomeViewModel
@{
    var succeededTotal = Model.Trend.Sum(point => point.Succeeded);
    var failedTotal = Model.Trend.Sum(point => point.Failed);
    var trendMax = Model.Trend.Count == 0 ? 0 : Model.Trend.Max(point => Math.Max(point.Succeeded, point.Failed));

    string FormatDuration(long ms) => ms < 1000 ? $"{ms} ms" : $"{ms / 1000.0:F1} s";
    string Truncate(string text, int max) => text.Length <= max ? text : text[..max] + "…";
}

<section class="page-head home-hero">
    <p class="eyebrow">任务调度平台 · 基于 Hangfire</p>
    <h1>定时任务，从这里<span class="text-gradient">调度与观察</span></h1>
    <p class="subhead">
        Api 负责入队、Dashboard 与运维接口；作业由独立的 Worker 服务执行，
        刷新页面即可查看最新状态汇总，数据来自 Hangfire 监控接口。
    </p>
    <div class="actions">
        <a class="btn btn-primary" href="@Model.DashboardPath">打开 Dashboard</a>
        <a class="btn btn-secondary" href="/run">任务运行台</a>
        <a class="btn btn-secondary" href="/api/tasks">任务列表 API</a>
        <a class="btn btn-secondary" href="/scalar">API 文档 (Scalar)</a>
    </div>
</section>

<section class="card" aria-label="运行概览">
    <div class="card-head">
        <h2>运行概览</h2>
        @if (Model.Authenticated && Model.HeartbeatEnabled)
        {
            <span class="status-badge">
                心跳 <time data-local-time datetime="@(Model.HeartbeatLast?.ToString("o") ?? "")">@(Model.HeartbeatLast?.ToString("o") ?? "未注册")</time>
                @if (Model.HeartbeatNext is not null)
                {
                    <text>→ <time data-local-time datetime="@Model.HeartbeatNext?.ToString("o")">@Model.HeartbeatNext?.ToString("o")</time></text>
                }
            </span>
        }
    </div>
    <div class="metric-grid">
        <div class="metric"><div class="metric-body">@(Model.Stats?.Succeeded.ToString() ?? "—")</div><div class="metric-desc"><span class="metric-icon" aria-hidden="true">✓</span>成功</div></div>
        <div class="metric @(Model.Stats is { Failed: > 0 } ? "metric-danger" : "")"><div class="metric-body">@(Model.Stats?.Failed.ToString() ?? "—")</div><div class="metric-desc"><span class="metric-icon" aria-hidden="true">✕</span>失败</div></div>
        <div class="metric"><div class="metric-body">@(Model.Stats?.Enqueued.ToString() ?? "—")</div><div class="metric-desc"><span class="metric-icon" aria-hidden="true">⁝</span>排队</div></div>
        <div class="metric"><div class="metric-body">@(Model.Stats?.Processing.ToString() ?? "—")</div><div class="metric-desc"><span class="metric-icon" aria-hidden="true">◐</span>处理中</div></div>
        <div class="metric"><div class="metric-body">@(Model.Stats?.Scheduled.ToString() ?? "—")</div><div class="metric-desc"><span class="metric-icon" aria-hidden="true">⏱</span>已预约</div></div>
        <div class="metric"><div class="metric-body">@(Model.Stats?.Recurring.ToString() ?? "—")</div><div class="metric-desc"><span class="metric-icon" aria-hidden="true">↻</span>定时任务</div></div>
        <div class="metric @(Model.Authenticated ? (Model.WorkerOnline ? "metric-success" : "metric-danger") : "")">
            <div class="metric-body">@(Model.Stats?.Servers.ToString() ?? "—")</div>
            <div class="metric-desc"><span class="metric-icon" aria-hidden="true">◈</span>@(Model.Authenticated ? (Model.WorkerOnline ? "Worker 在线" : "无 Worker") : "Worker")</div>
        </div>
    </div>
    @if (!Model.Authenticated)
    {
        <p class="hint">统计需要管理员鉴权：<a href="/login">先登录</a>，再刷新本页。</p>
    }
    else if (Model.Trend.Count > 0 && trendMax > 0)
    {
        @* 迷你柱状图：服务端按 max 归一化柱高，零 JS；柱分组 flex 均分自适应宽度 *@
        <div class="trend" role="img" aria-label="近 24 小时执行趋势：成功 @succeededTotal 次，失败 @failedTotal 次">
            <div class="trend-bars" aria-hidden="true">
                @foreach (var point in Model.Trend)
                {
                    <span class="trend-group" title="@point.Hour.ToString("MM-dd HH:mm")　成功 @point.Succeeded · 失败 @point.Failed">
                        <i class="trend-bar bar-ok" style="height:@(trendMax == 0 ? 0 : (int)Math.Round(point.Succeeded * 100.0 / trendMax))%"></i>
                        <i class="trend-bar bar-bad" style="height:@(trendMax == 0 ? 0 : (int)Math.Round(point.Failed * 100.0 / trendMax))%"></i>
                    </span>
                }
            </div>
            <div class="trend-axis">
                <time data-local-time datetime="@Model.Trend[0].Hour.ToString("o")">@Model.Trend[0].Hour.ToString("MM-dd HH:mm")</time>
                <span class="trend-legend"><i class="dot dot-ok" aria-hidden="true"></i>成功<span class="trend-legend-sep"></span><i class="dot dot-bad" aria-hidden="true"></i>失败</span>
                <time data-local-time datetime="@Model.Trend[^1].Hour.ToString("o")">@Model.Trend[^1].Hour.ToString("MM-dd HH:mm")</time>
            </div>
        </div>
    }
    else
    {
        <div class="trend trend-empty">暂无执行数据 — 作业跑起来后，这里会显示近 24 小时的成功/失败趋势。</div>
    }
</section>

@if (Model.Authenticated)
{
    <section class="card recent-card" aria-label="最近执行">
        <div class="card-head">
            <h2>最近执行</h2>
            <span class="status-badge">@Model.Recent.Count 条</span>
        </div>
        @if (Model.Recent.Count == 0)
        {
            <div class="empty">暂无执行记录 — 触发或等待定时任务运行后展示。</div>
        }
        else
        {
            <ul class="recent-list">
                @foreach (var item in Model.Recent)
                {
                    <li class="recent-item">
                        <span class="state-dot @(item.State == "Succeeded" ? "ok" : "bad")" aria-hidden="true"></span>
                        <span class="recent-name">
                            <strong>@(item.JobName ?? item.JobId)</strong>
                            <span class="muted mono-sm word-break">@item.JobId</span>
                        </span>
                        <span class="recent-meta">
                            @if (item.DurationMs is long duration)
                            {
                                <span>@FormatDuration(duration)</span>
                            }
                            <time data-local-time datetime="@(item.OccurredAt?.ToString("o") ?? "")">@(item.OccurredAt?.ToString("MM-dd HH:mm:ss") ?? "—")</time>
                        </span>
                        @if (item.Reason is string reason && reason.Length > 0)
                        {
                            <span class="recent-reason muted" title="@reason">@Truncate(reason, 90)</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>
}

<section class="entry-grid" aria-label="能力入口">
    <a class="card entry" href="@Model.DashboardPath">
        <span class="entry-arrow">↗</span>
        <h3><span class="entry-icon" aria-hidden="true">◎</span>Hangfire Dashboard</h3>
        <p>实时查看队列、重试与服务器状态，生产环境经管理员鉴权进入。</p>
    </a>
    <a class="card entry" href="/run">
        <span class="entry-arrow">↗</span>
        <h3><span class="entry-icon" aria-hidden="true">▶</span>任务运行台</h3>
        <p>按名称过滤已注册任务，一键立即运行，需管理员会话。</p>
    </a>
    <a class="card entry" href="/api/tasks">
        <span class="entry-arrow">↗</span>
        <h3><span class="entry-icon" aria-hidden="true">⇄</span>运维 REST</h3>
        <p><code>/api/tasks</code> 提供清单、统计、启停、触发与 Cron 覆盖，凭 <code>X-TaskRunner-Admin</code> 密钥调用。</p>
    </a>
    <a class="card entry" href="/info">
        <span class="entry-arrow">↗</span>
        <h3><span class="entry-icon" aria-hidden="true">⬡</span>插件式任务</h3>
        <p>实现 <code>IRecurringJob</code> 的程序集经 <code>AddTaskRunnerCore</code> 注入，重启即自动注册。</p>
    </a>
</section>
