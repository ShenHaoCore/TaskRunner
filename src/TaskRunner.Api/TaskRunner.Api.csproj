<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>TaskRunner.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskRunner.Core\TaskRunner.Core.csproj" />
    <ProjectReference Include="..\TaskRunner.Hangfire\TaskRunner.Hangfire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\appsettings.shared.json" Link="appsettings.shared.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\appsettings.Development.shared.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\appsettings.Production.shared.json" Link="appsettings.Production.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.22" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="9.0.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.22">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.6" />
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
  </ItemGroup>

</Project>
