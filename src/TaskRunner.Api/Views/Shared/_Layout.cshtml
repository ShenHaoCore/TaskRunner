@using Microsoft.Extensions.Options
@using TaskRunner.Core.Common
@inject IOptions<TaskRunnerOptions> HangfireOptions
@inject IHostEnvironment HostEnv
@{
    var navActive = ViewData["NavActive"] as string ?? "";
    var dashboardPath = HangfireOptions.Value.NormalizeDashboardPath();
    var readOnly = HangfireOptions.Value.ReadOnlyMode;
    var authenticated = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "TaskRunner")</title>
    <link rel="icon" href="~/mark.svg" type="image/svg+xml" />
    <script>
        // 主题初始化须在样式应用前完成，避免闪烁（Linear 深色为默认）
        document.documentElement.setAttribute(
            "data-theme",
            localStorage.getItem("tr-theme") === "light" ? "light" : "dark");
    </script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
</head>
<body>
    <div class="top-nav">
        <div class="container nav-inner">
            <a class="brand" href="/"><img class="brand-mark" src="~/mark.svg" alt="" />TaskRunner</a>
            <nav class="nav-links" aria-label="主导航">
                <a href="/" class="@(navActive == "home" ? "active" : null)">仪表盘</a>
                <a href="/run" class="@(navActive == "run" ? "active" : null)">运行台</a>
                <a href="@dashboardPath">Dashboard</a>
                <a href="/api/tasks">任务 API</a>
            </nav>
            <span class="nav-spacer"></span>
            <span class="status-badge">@HostEnv.EnvironmentName@(readOnly ? " · 只读" : "")</span>
            <button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换亮暗主题">☾</button>
            @if (authenticated)
            {
                <span class="nav-user">@User.Identity?.Name</span>
                <form method="post" asp-controller="Account" asp-action="Logout" class="inline-form">
                    <button type="submit" class="btn btn-secondary btn-sm">退出</button>
                </form>
            }
            else
            {
                <a class="btn btn-primary btn-sm" href="/login">登录</a>
            }
        </div>
    </div>

    <main class="container page">
        @if (TempData["Flash"] is string flashOk)
        {
            <div class="flash flash-success" role="status" data-auto-dismiss="true">@flashOk</div>
        }
        @if (TempData["FlashError"] is string flashErr)
        {
            <div class="flash flash-danger" role="alert">@flashErr</div>
        }
        @RenderBody()
    </main>

    <footer class="foot">
        <div class="container foot-inner">
            <span>TaskRunner · 生产形态 Api + Worker 双服务</span>
            <span><a href="/info">/info</a> · <a href="/health">/health</a></span>
        </div>
    </footer>

    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script>
        // 成功提示 5 秒自动淡出（悬停暂停）；失败提示常驻，由用户下次操作带走
        (function () {
            document.querySelectorAll(".flash[data-auto-dismiss='true']").forEach(function (el) {
                var timer = setTimeout(function () { dismiss(el); }, 5000);
                el.addEventListener("mouseenter", function () { clearTimeout(timer); });
            });
            function dismiss(el) {
                el.classList.add("flash-leaving");
                setTimeout(function () { el.remove(); }, 300);
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
