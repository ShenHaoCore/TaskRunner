[Unit]
Description=TaskRunner Worker (Hangfire Server)
Wants=network-online.target
# 排在 Api 之后：首启迁移建表由 Api 先行完成，规避双进程同时迁移的竞态
After=network-online.target postgresql.service taskrunner-api.service

[Service]
Type=notify
User=taskrunner
Group=taskrunner
WorkingDirectory=/opt/taskrunner/worker
Environment=ASPNETCORE_ENVIRONMENT=Production
EnvironmentFile=-/etc/default/taskrunner
ExecStart=/opt/taskrunner/worker/TaskRunner.Worker
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=taskrunner-worker

[Install]
WantedBy=multi-user.target
