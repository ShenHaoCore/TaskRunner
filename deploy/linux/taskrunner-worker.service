[Unit]
Description=TaskRunner Worker (Hangfire Server)
Wants=network-online.target
# 排在 Api 之后：首启迁移建表由 Api 先行完成，规避双进程同时迁移的竞态
After=network-online.target postgresql.service taskrunner-api.service

[Service]
Type=notify
User=taskrunner
Group=taskrunner
WorkingDirectory=/opt/taskrunner/worker
Environment=ASPNETCORE_ENVIRONMENT=Production
EnvironmentFile=-/etc/default/taskrunner
# 占位符未改完则拒绝启动；只改 /etc/default/taskrunner，勿改包内 appsettings
ExecStartPre=/usr/bin/bash -c 'test -f /etc/default/taskrunner && ! grep -q CHANGE_ME /etc/default/taskrunner || { echo "Edit /etc/default/taskrunner (replace CHANGE_ME); do not edit appsettings.json" >&2; exit 1; }'
ExecStart=/opt/taskrunner/worker/TaskRunner.Worker
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
SyslogIdentifier=taskrunner-worker

# 安全硬化（systemd.exec(5)）：.NET JIT 需要 W+X 内存，故不加 MemoryDenyWriteExecute
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
