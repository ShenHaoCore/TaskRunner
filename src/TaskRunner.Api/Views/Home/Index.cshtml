@model TaskRunner.Api.Controllers.HomeController.HomeViewModel

<section class="page-head">
    <p class="eyebrow">任务调度平台 · 基于 Hangfire</p>
    <h1>定时任务，从这里调度与观察</h1>
    <p class="subhead">
        Api 负责入队、Dashboard 与运维接口；作业由独立的 Worker 服务执行，
        状态实时汇总在下方，数据来自 Hangfire 监控接口。
    </p>
    <div class="actions">
        <a class="btn btn-primary" href="@Model.DashboardPath">打开 Dashboard</a>
        <a class="btn btn-secondary" href="/run">任务运行台</a>
        <a class="btn btn-secondary" href="/api/tasks">任务列表 API</a>
        <a class="btn btn-secondary" href="/scalar">API 文档 (Scalar)</a>
    </div>
</section>

<section class="card" aria-label="运行概览">
    <div class="card-head">
        <h2>运行概览</h2>
        @if (Model.Authenticated && Model.HeartbeatEnabled)
        {
            <span class="status-badge">
                心跳 <time data-local-time datetime="@(Model.HeartbeatLast?.ToString("o") ?? "")">@(Model.HeartbeatLast?.ToString("o") ?? "未注册")</time>
                @if (Model.HeartbeatNext is not null)
                {
                    <text>→ <time data-local-time datetime="@Model.HeartbeatNext?.ToString("o")">@Model.HeartbeatNext?.ToString("o")</time></text>
                }
            </span>
        }
    </div>
    <div class="metric-grid">
        <div class="metric"><div class="metric-body">@(Model.Stats?.Succeeded.ToString() ?? "—")</div><div class="metric-desc">成功</div></div>
        <div class="metric metric-danger"><div class="metric-body">@(Model.Stats?.Failed.ToString() ?? "—")</div><div class="metric-desc">失败</div></div>
        <div class="metric"><div class="metric-body">@(Model.Stats?.Enqueued.ToString() ?? "—")</div><div class="metric-desc">排队</div></div>
        <div class="metric"><div class="metric-body">@(Model.Stats?.Processing.ToString() ?? "—")</div><div class="metric-desc">处理中</div></div>
        <div class="metric"><div class="metric-body">@(Model.Stats?.Recurring.ToString() ?? "—")</div><div class="metric-desc">定时任务</div></div>
        <div class="metric @(Model.Authenticated ? (Model.WorkerOnline ? "metric-success" : "metric-danger") : "")">
            <div class="metric-body">@(Model.Stats?.Servers.ToString() ?? "—")</div>
            <div class="metric-desc">@(Model.Authenticated ? (Model.WorkerOnline ? "Worker 在线" : "无 Worker") : "Worker")</div>
        </div>
    </div>
    @if (!Model.Authenticated)
    {
        <p class="hint">统计需要管理员鉴权：<a href="/login">先登录</a>，再刷新本页。</p>
    }
</section>

<section class="entry-grid" aria-label="能力入口">
    <a class="card entry" href="@Model.DashboardPath">
        <span class="entry-arrow">↗</span>
        <h3>Hangfire Dashboard</h3>
        <p>实时查看队列、重试与服务器状态，生产环境经管理员鉴权进入。</p>
    </a>
    <a class="card entry" href="/run">
        <span class="entry-arrow">↗</span>
        <h3>任务运行台</h3>
        <p>按名称过滤已注册任务，一键立即运行，需管理员会话。</p>
    </a>
    <a class="card entry" href="/api/tasks">
        <span class="entry-arrow">↗</span>
        <h3>运维 REST</h3>
        <p><code>/api/tasks</code> 提供清单、统计、启停、触发与 Cron 覆盖，凭 <code>X-TaskRunner-Admin</code> 密钥调用。</p>
    </a>
    <a class="card entry" href="/info">
        <span class="entry-arrow">↗</span>
        <h3>插件式任务</h3>
        <p>实现 <code>IRecurringJob</code> 的程序集经 <code>AddTaskRunnerCore</code> 注入，重启即自动注册。</p>
    </a>
</section>
