@model TaskRunner.Api.Controllers.HomeController.HomeViewModel

<section class="page-head home-hero">
    <p class="eyebrow">任务调度平台 · 基于 Hangfire</p>
    <h1>定时任务，从这里<span class="text-gradient">调度与观察</span></h1>
    <p class="subhead">
        队列、重试与实时图表在 Hangfire Dashboard；本页只保留健康信号与入口。
        登录后可见 Worker、心跳与失败记录。
    </p>
    <div class="actions">
        <a class="btn btn-primary" href="@Model.DashboardPath">打开 Dashboard</a>
        <a class="btn btn-secondary" href="/run">任务运行台</a>
    </div>
</section>

<section class="card" aria-label="系统状态">
    <div class="card-head">
        <h2>系统状态</h2>
        @if (Model.Authenticated && Model.HeartbeatEnabled)
        {
            <span class="status-badge">
                心跳 <time data-local-time datetime="@(Model.HeartbeatLast?.ToString("o") ?? "")">@(Model.HeartbeatLast?.ToString("o") ?? "未注册")</time>
                @if (Model.HeartbeatNext is not null)
                {
                    <text>→ <time data-local-time datetime="@Model.HeartbeatNext?.ToString("o")">@Model.HeartbeatNext?.ToString("o")</time></text>
                }
            </span>
        }
    </div>

    @if (!Model.Authenticated)
    {
        <p class="hint">健康状态需要管理员鉴权：<a href="/login">先登录</a>，再刷新本页。</p>
    }
    else
    {
        var enqueued = Model.Stats?.Enqueued ?? 0;
        var failed = Model.Stats?.Failed ?? 0;

        <ul class="status-list">
            <li class="status-row">
                <span class="state-dot @(Model.WorkerOnline ? "ok" : "bad")" aria-hidden="true"></span>
                <span class="status-name">Worker</span>
                <span class="status-value @(Model.WorkerOnline ? "ok" : "bad")">
                    @(Model.WorkerOnline ? $"在线（{Model.Stats?.Servers}）" : "离线 — 作业将滞留队列")
                </span>
            </li>
            <li class="status-row">
                <span class="state-dot @(enqueued > 0 ? "neutral" : "ok")" aria-hidden="true"></span>
                <span class="status-name">排队</span>
                <span class="status-value">@(enqueued > 0 ? $"{enqueued} 个作业待执行" : "队列空闲")</span>
            </li>
            <li class="status-row">
                <span class="state-dot @(failed > 0 ? "bad" : "ok")" aria-hidden="true"></span>
                <span class="status-name">失败</span>
                <span class="status-value @(failed > 0 ? "bad" : "")">@(failed > 0 ? $"{failed} 条失败记录" : "无失败记录")</span>
            </li>
        </ul>

        @if (Model.RecentFailures.Count > 0)
        {
            <div class="recent-block">
                <h3 class="recent-title">最近失败</h3>
                <ul class="recent-list">
                    @foreach (var item in Model.RecentFailures)
                    {
                        <li class="recent-item">
                            <span class="state-dot bad" aria-hidden="true"></span>
                            <span class="recent-name">
                                <strong>@(item.JobName ?? item.JobId)</strong>
                                <span class="muted mono-sm word-break">@item.JobId</span>
                            </span>
                            <time class="recent-meta" data-local-time datetime="@(item.OccurredAt?.ToString("o") ?? "")">@(item.OccurredAt?.ToString("MM-dd HH:mm:ss") ?? "—")</time>
                        </li>
                        @if (item.Reason is string reason && reason.Length > 0)
                        {
                            <li class="recent-reason muted" title="@reason">@reason</li>
                        }
                    }
                </ul>
                <p class="hint"><a href="@Model.DashboardPath">在 Dashboard 查看全部失败作业 →</a></p>
            </div>
        }
    }
</section>
