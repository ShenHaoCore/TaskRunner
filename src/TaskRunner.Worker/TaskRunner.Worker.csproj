<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <RootNamespace>TaskRunner.Worker</RootNamespace>
    <!-- 与 Api 共用，本地连接串等只设一次 -->
    <UserSecretsId>dd52fdfc-c6a8-4102-91fc-791812bb91fe</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskRunner.Core\TaskRunner.Core.csproj" />
    <ProjectReference Include="..\TaskRunner.Hangfire\TaskRunner.Hangfire.csproj" />
    <ProjectReference Include="..\TaskRunner.PlatformJobs\TaskRunner.PlatformJobs.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\appsettings.json" Link="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\appsettings.Development.json" Link="appsettings.Development.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

</Project>
